---
title: Calendar
layout: base.njk
permalink: /calendar/
eleventyComputed:
  meta:
    description: "View upcoming shows and events at Stars & Garters."
    image: "{{ site.logo }}"
    url: "{{ site.url }}/calendar/"
    ogType: "website"
---

{%- set calendarSchema = events | upcomingEventsSchema(shows, site) -%}
{%- if calendarSchema %}
<script type="application/ld+json">
{{ calendarSchema | safe }}
</script>
{%- endif %}

<div id="calendar-app" class="w-full">
    <div class="flex items-center justify-between mb-6">
        <button id="prev-month" class="font-inter text-neutral-400 hover:text-white px-4 py-2 cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed">
            <span id="prev-month-label"></span>
        </button>
        <h2 id="month-title" class="font-oswald text-2xl uppercase"></h2>
        <button id="next-month" class="font-inter text-neutral-400 hover:text-white px-4 py-2 cursor-pointer disabled:opacity-30 disabled:cursor-not-allowed">
            <span id="next-month-label">&rarr;</span>
        </button>
    </div>

    <!-- Day Modal -->
    <div id="day-modal" class="fixed inset-0 z-50 hidden">
        <div class="absolute inset-0 bg-black/80" id="modal-backdrop"></div>
        <div class="absolute inset-0 flex items-center justify-center p-4">
            <div class="bg-neutral-900 border border-neutral-700 w-full max-w-lg max-h-[80vh] overflow-hidden flex flex-col">
                <div class="flex items-center justify-between p-4 border-b border-neutral-700">
                    <h3 id="modal-title" class="font-oswald text-xl uppercase text-white"></h3>
                    <button id="modal-close" class="text-neutral-400 hover:text-white text-2xl leading-none">&times;</button>
                </div>
                <div id="modal-content" class="p-4 space-y-3 overflow-y-auto"></div>
            </div>
        </div>
    </div>

    <!-- Desktop Calendar Grid -->
    <div class="hidden md:block" style="width: 100%;">
        <div class="grid gap-px bg-neutral-600" style="width: 100%; grid-template-columns: repeat(7, 1fr);">
            <div class="bg-neutral-800 p-3 text-center font-inter text-sm text-neutral-300">Sun</div>
            <div class="bg-neutral-800 p-3 text-center font-inter text-sm text-neutral-300">Mon</div>
            <div class="bg-neutral-800 p-3 text-center font-inter text-sm text-neutral-300">Tue</div>
            <div class="bg-neutral-800 p-3 text-center font-inter text-sm text-neutral-300">Wed</div>
            <div class="bg-neutral-800 p-3 text-center font-inter text-sm text-neutral-300">Thu</div>
            <div class="bg-neutral-800 p-3 text-center font-inter text-sm text-neutral-300">Fri</div>
            <div class="bg-neutral-800 p-3 text-center font-inter text-sm text-neutral-300">Sat</div>
        </div>
        <div id="calendar-grid" class="grid gap-px bg-neutral-600" style="width: 100%; grid-template-columns: repeat(7, 1fr);"></div>
    </div>

    <!-- Mobile List View -->
    <div id="mobile-calendar" class="md:hidden space-y-4"></div>
</div>

<script>
// Events with a linkUrl are actually part of another ticketed show (they point
// to it), so they're not listed as standalone entries on the calendar.
const events = ({{ events | dump | safe }}).filter(e => !e.linkUrl);
const shows = {{ shows | dump | safe }};
const closures = {{ closures | dump | safe }};

const showMap = {};
shows.forEach(s => showMap[s.slug] = s);

const closureMap = {};
closures.forEach(c => closureMap[c.date] = c.label || 'Theater Closed');

const classesData = {{ classes | dump | safe }};
classesData.forEach(cls => {
    if (cls.dates && cls.dates.length) {
        showMap['_class_' + cls.slug] = {
            title: cls.title,
            poster: cls.poster,
            isClass: true,
            classSlug: cls.slug
        };
        cls.dates.forEach(d => {
            const displayName = d.label ? cls.title + ' ' + d.label : cls.title;
            events.push({
                date: d.date,
                time: d.time || '',
                show: '_class_' + cls.slug,
                isClass: true,
                classSlug: cls.slug,
                displayName: displayName
            });
        });
    }
});

function parseTimeTo24(timeStr) {
    if (!timeStr) return 0;
    const [timePart = '0:00', ampm] = timeStr.split(' ');
    let [h = 0, m = 0] = timePart.split(':').map(n => parseInt(n, 10) || 0);
    if (ampm === 'PM' && h !== 12) h += 12;
    if (ampm === 'AM' && h === 12) h = 0;
    return h * 60 + m;
}
events.sort((a, b) => a.date.localeCompare(b.date) || parseTimeTo24(a.time) - parseTimeTo24(b.time));

const monthNames = ["January", "February", "March", "April", "May", "June",
                    "July", "August", "September", "October", "November", "December"];
const dayNames = ["Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"];

const today = new Date();
const currentMonth = today.getMonth();
const currentYear = today.getFullYear();
const todayMidnight = new Date(currentYear, currentMonth, today.getDate());

const todayStr = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
const currentMonthPrefix = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}`;
const hasRemainingThisMonth = events.some(e => e.date.startsWith(currentMonthPrefix) && e.date >= todayStr);

function hasEventsInMonth(year, month) {
    const prefix = `${year}-${String(month + 1).padStart(2, '0')}`;
    return events.some(e => e.date.startsWith(prefix));
}

function getEventsForDate(dateStr) {
    return events.filter(e => e.date === dateStr);
}

function fmtDate(dt) {
    return `${dt.getFullYear()}-${String(dt.getMonth() + 1).padStart(2, '0')}-${String(dt.getDate()).padStart(2, '0')}`;
}

// --- Build the ordered list of navigable views ----------------------------
// First month to display: current month, or next month if nothing remains this month.
let firstMonth = currentMonth;
let firstYear = currentYear;
if (!hasRemainingThisMonth) {
    firstMonth++;
    if (firstMonth > 11) { firstMonth = 0; firstYear++; }
}

// When we're within 7 days of the end of the current month, the leftover
// weekend looks empty on its own, so fold the current month and all of next
// month into a single combined first view (e.g. "July / August"). Navigating
// "next" from there lands on the month after (e.g. September).
const lastDayOfCurrentMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
const daysUntilMonthEnd = lastDayOfCurrentMonth - today.getDate();
const combineFirst = hasRemainingThisMonth && daysUntilMonthEnd <= 7;

// Latest month with any event, to bound the view list.
let maxMonthKey = firstYear * 12 + firstMonth;
events.forEach(e => {
    const [y, m] = e.date.split('-').map(Number);
    const key = y * 12 + (m - 1);
    if (key > maxMonthKey) maxMonthKey = key;
});

// Every month that has events, from the first month onward.
const monthsWithEvents = [];
for (let key = firstYear * 12 + firstMonth; key <= maxMonthKey; key++) {
    const y = Math.floor(key / 12);
    const m = key % 12;
    if (hasEventsInMonth(y, m)) monthsWithEvents.push({ year: y, month: m });
}

// Each view shows one month, except an optional combined first view spanning
// the current month + the next calendar month.
const views = [];
if (combineFirst) {
    let nm = firstMonth + 1, ny = firstYear;
    if (nm > 11) { nm = 0; ny++; }
    views.push({ months: [{ year: firstYear, month: firstMonth }, { year: ny, month: nm }] });
    const cutoffKey = ny * 12 + nm;
    monthsWithEvents.forEach(mm => {
        if (mm.year * 12 + mm.month > cutoffKey) views.push({ months: [mm] });
    });
} else {
    monthsWithEvents.forEach(mm => views.push({ months: [mm] }));
}
if (views.length === 0) {
    views.push({ months: [{ year: firstYear, month: firstMonth }] });
}

let viewIndex = 0;

function viewTitle(view) {
    const ms = view.months;
    const a = ms[0], b = ms[ms.length - 1];
    if (ms.length === 1) return `${monthNames[a.month]} ${a.year}`;
    if (a.year === b.year) return `${monthNames[a.month]} / ${monthNames[b.month]} ${a.year}`;
    return `${monthNames[a.month]} ${a.year} / ${monthNames[b.month]} ${b.year}`;
}

function viewShortLabel(view) {
    const ms = view.months;
    if (ms.length === 1) return monthNames[ms[0].month];
    return `${monthNames[ms[0].month]} / ${monthNames[ms[ms.length - 1].month]}`;
}

function viewRange(view) {
    const first = view.months[0];
    const last = view.months[view.months.length - 1];
    let startDate = new Date(first.year, first.month, 1);
    // For the current month, start at the Sunday of this week so past weeks hide.
    if (first.year === currentYear && first.month === currentMonth) {
        const weekStart = new Date(currentYear, currentMonth, today.getDate() - today.getDay());
        if (weekStart.getMonth() === currentMonth && weekStart.getFullYear() === currentYear) {
            startDate = weekStart;
        }
    }
    const endDate = new Date(last.year, last.month + 1, 0);
    return { startDate, endDate };
}

// Modal functionality
const modal = document.getElementById('day-modal');
const modalTitle = document.getElementById('modal-title');
const modalContent = document.getElementById('modal-content');
const modalBackdrop = document.getElementById('modal-backdrop');
const modalClose = document.getElementById('modal-close');

function openDayModal(dateStr, dayEvents) {
    const dateObj = new Date(dateStr + 'T12:00:00');
    const dayName = dayNames[dateObj.getDay()];
    const month = monthNames[dateObj.getMonth()];
    const day = dateObj.getDate();

    modalTitle.textContent = `${dayName}, ${month} ${day}`;

    let html = '';
    dayEvents.forEach(event => {
        const show = showMap[event.show];
        if (show) {
            const poster = event.poster || show.poster;
            let displayName = show.title;
            let linkUrl = '/show/' + event.show + '/';

            if (event.displayName) {
                displayName = event.displayName;
            } else if (event.title) {
                if (show.eventTitleFormat === 'event-first') {
                    displayName = event.title + ': ' + show.title;
                } else {
                    displayName = show.title + ': ' + event.title;
                }
            }

            if (show.createEventPages && event.title) {
                const eventSlug = event.title
                    .toLowerCase()
                    .replace(/[^a-z0-9]+/g, '-')
                    .replace(/^-|-$/g, '');
                linkUrl = '/show/' + event.show + '/' + eventSlug + '/';
            }

            if (show.isClass) {
                linkUrl = '/classes/' + show.classSlug + '/';
            }

            html += `<a href="${linkUrl}" class="flex items-center gap-4 p-3 bg-neutral-800 hover:bg-neutral-700 transition-colors">`;
            if (poster) {
                html += `<div class="w-20 h-30 shrink-0 bg-neutral-900 overflow-hidden">`;
                html += `<img loading="lazy" decoding="async" src="/posters/${poster}" alt="${displayName}" class="w-full h-full object-cover">`;
                html += `</div>`;
            }
            html += `<div class="flex-1 min-w-0">`;
            html += `<p class="font-oswald text-2xl text-white truncate">${displayName}</p>`;
            html += `<p class="font-inter text-lg text-neutral-400">${event.time}</p>`;
            if (show.room) {
                html += `<p class="font-inter text-base text-neutral-500">${show.room}</p>`;
            }
            html += `</div>`;
            html += `</a>`;
        }
    });

    modalContent.innerHTML = html;
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
}

function closeModal() {
    modal.classList.add('hidden');
    document.body.style.overflow = '';
}

modalBackdrop.addEventListener('click', closeModal);
modalClose.addEventListener('click', closeModal);
document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
});

const EMPTY_CELL = '<div class="bg-neutral-900 min-h-[160px] p-2 pb-3 min-w-0"></div>';

function renderDayCell(dateObj) {
    const dateStr = fmtDate(dateObj);
    const day = dateObj.getDate();
    const dayEvents = getEventsForDate(dateStr);
    const isToday = dateObj.getTime() === todayMidnight.getTime();
    const isPast = dateObj < todayMidnight;
    const closureLabel = closureMap[dateStr];

    const cellClasses = isToday ? 'bg-white/10 border-2 border-white' : 'bg-neutral-900';
    const hasEvents = dayEvents.length > 0 && !isPast;
    const clickableClass = hasEvents ? 'cursor-pointer hover:bg-neutral-800' : '';

    let html = `<div class="${cellClasses} ${clickableClass} min-h-[160px] p-2 pb-3 overflow-hidden min-w-0 ${isPast ? 'opacity-50' : ''}" ${hasEvents ? `data-date="${dateStr}"` : ''}>`;
    html += `<div class="font-inter text-sm ${isToday ? 'text-white font-bold' : 'text-neutral-300'} mb-2">${day}</div>`;

    dayEvents.forEach(event => {
        const show = showMap[event.show];
        if (show) {
            let displayName = show.title;
            if (event.displayName) {
                displayName = event.displayName;
            } else if (event.title) {
                displayName = show.eventTitleFormat === 'event-first'
                    ? event.title + ': ' + show.title
                    : show.title + ': ' + event.title;
            }
            html += `<div class="mb-3">
                <div class="text-xs font-inter text-neutral-400">${event.time}</div>
                <div class="text-sm font-inter text-white leading-tight">${displayName}</div>
            </div>`;
        }
    });

    if (closureLabel && !isPast) {
        html += `<div class="text-sm font-inter italic text-neutral-500 leading-tight">${closureLabel}</div>`;
    }

    html += '</div>';
    return html;
}

function renderCalendar() {
    const grid = document.getElementById('calendar-grid');
    const mobileList = document.getElementById('mobile-calendar');
    const title = document.getElementById('month-title');
    const prevBtn = document.getElementById('prev-month');
    const nextBtn = document.getElementById('next-month');
    const prevLabel = document.getElementById('prev-month-label');
    const nextLabel = document.getElementById('next-month-label');

    const view = views[viewIndex];
    title.textContent = viewTitle(view);

    prevBtn.disabled = viewIndex <= 0;
    nextBtn.disabled = viewIndex >= views.length - 1;
    prevLabel.textContent = viewIndex > 0 ? `← ${viewShortLabel(views[viewIndex - 1])}` : '';
    nextLabel.textContent = viewIndex < views.length - 1 ? `${viewShortLabel(views[viewIndex + 1])} →` : '→';

    const { startDate, endDate } = viewRange(view);

    // Desktop grid: one continuous run of week rows across the whole range.
    let html = '';
    for (let i = 0; i < startDate.getDay(); i++) html += EMPTY_CELL;

    const cursor = new Date(startDate);
    while (cursor <= endDate) {
        html += renderDayCell(cursor);
        cursor.setDate(cursor.getDate() + 1);
    }

    for (let i = endDate.getDay() + 1; i < 7; i++) html += EMPTY_CELL;

    grid.innerHTML = html;

    // Mobile list view: only days with events/closures, skipping past dates.
    let mobileHtml = '';
    const mCursor = new Date(startDate);
    while (mCursor <= endDate) {
        const dateStr = fmtDate(mCursor);
        const dayEvents = getEventsForDate(dateStr);
        const closureLabel = closureMap[dateStr];
        const isPast = mCursor < todayMidnight;

        if (!isPast && (dayEvents.length > 0 || closureLabel)) {
            const dayName = dayNames[mCursor.getDay()];
            const isToday = mCursor.getTime() === todayMidnight.getTime();
            const isClickable = dayEvents.length > 0;

            mobileHtml += `<div class="border border-neutral-700 ${isToday ? 'border-white' : ''} ${isClickable ? 'cursor-pointer hover:border-neutral-500' : ''}" ${isClickable ? `data-date="${dateStr}"` : ''}>`;
            mobileHtml += `<div class="bg-neutral-800 px-4 py-2 font-oswald uppercase ${isToday ? 'text-white' : 'text-neutral-300'}">`;
            mobileHtml += `${dayName}, ${monthNames[mCursor.getMonth()]} ${mCursor.getDate()}`;
            mobileHtml += `</div>`;
            mobileHtml += `<div class="p-4 space-y-2">`;

            if (closureLabel) {
                mobileHtml += `<div class="font-inter italic text-neutral-500">${closureLabel}</div>`;
            }

            dayEvents.forEach(event => {
                const show = showMap[event.show];
                if (show) {
                    let displayName = show.title;
                    if (event.displayName) {
                        displayName = event.displayName;
                    } else if (event.title) {
                        displayName = show.eventTitleFormat === 'event-first'
                            ? event.title + ': ' + show.title
                            : show.title + ': ' + event.title;
                    }
                    mobileHtml += `<div class="flex items-center gap-3 p-2 bg-neutral-900">`;
                    mobileHtml += `<span class="font-inter text-sm text-neutral-400 w-20 shrink-0">${event.time}</span>`;
                    mobileHtml += `<span class="font-inter text-white">${displayName}</span>`;
                    mobileHtml += `</div>`;
                }
            });

            mobileHtml += `</div></div>`;
        }
        mCursor.setDate(mCursor.getDate() + 1);
    }

    if (mobileHtml === '') {
        mobileHtml = '<p class="font-inter text-neutral-400 text-center py-8">No upcoming events this month.</p>';
    }
    mobileList.innerHTML = mobileHtml;

    // Add click handlers for day cells
    document.querySelectorAll('[data-date]').forEach(cell => {
        cell.addEventListener('click', () => {
            const dateStr = cell.dataset.date;
            const dayEvents = getEventsForDate(dateStr);
            if (dayEvents.length > 0) {
                openDayModal(dateStr, dayEvents);
            }
        });
    });
}

document.getElementById('prev-month').addEventListener('click', () => {
    if (viewIndex > 0) {
        viewIndex--;
        renderCalendar();
    }
});

document.getElementById('next-month').addEventListener('click', () => {
    if (viewIndex < views.length - 1) {
        viewIndex++;
        renderCalendar();
    }
});

renderCalendar();
</script>
